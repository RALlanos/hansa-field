{
  "name": "@hansa-field/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file=../../.env.example src/main.ts",
    "db:migrate": "tsx --env-file=../../.env.example src/database/migrate.ts up",
    "db:rollback": "tsx --env-file=../../.env.example src/database/migrate.ts down",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:unit": "vitest run --exclude src/database/migrator.spec.ts",
    "test:integration": "vitest run src/database/migrator.spec.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-fastify": "12.0.1",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.1",
    "@types/node": "24.10.1",
    "@types/pg": "8.18.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
